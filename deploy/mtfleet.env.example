# Copy to /etc/mtfleet.env and set a real password, then: chmod 600 /etc/mtfleet.env
FLEET_USER=admin
FLEET_PASSWORD=change-this-to-something-strong
# Optional overrides:
# FLEET_PORT is set in the service ExecStart, not here
# FLEET_TIMEOUT=8
# FLEET_WORKERS=32
# FLEET_DB=/home/joel/fleet/routers.json
# FLEET_BACKUPS=/home/joel/fleet/backups
